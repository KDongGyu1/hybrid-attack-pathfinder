# docker-compose.prod.yml이 참고하는 실제 배포용 env 템플릿.
# 실제 값을 채운 .env.production은 hap-soc-api EC2에만 두고, 저장소에는 커밋하지 않는다.
# 2026-07-22 인프라팀 확인 값 기준.

DB_HOST=# hap-soc-auth-db RDS 엔드포인트 (인프라팀에 요청)
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=# Secrets Manager: hap-soc-db-secret
DB_DATABASE=hybrid_attack_path

JWT_ACCESS_SECRET=# Secrets Manager: hap-soc-jwt-secret 의 "access" 값
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=# Secrets Manager: hap-soc-jwt-secret 의 "refresh" 값
JWT_REFRESH_EXPIRES_IN=7d

GRAPH_ENGINE_BASE_URL=http://10.1.20.20:8000
