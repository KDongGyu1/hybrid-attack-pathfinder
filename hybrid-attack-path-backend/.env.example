# App
PORT=3000

# JWT
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hybrid_attack_path

# Backend 1 (Neo4j 탐색 엔진, FastAPI) 연동 - GraphService 어댑터가 사용
# uvicorn 기본 포트는 8000. 상범님이 --port로 다른 포트를 쓰면 여기도 맞춰야 함.
GRAPH_ENGINE_BASE_URL=http://localhost:8000
